{% extends 'base.html.twig' %}

{% block titulo %}Carrito de la compra{% endblock %}

{% block contenido %}
    <p>Total de productos: <strong>{{ total }}</strong></p>
    {% if carrito %}
        <ul>
            {% for producto in carrito %}
                <li>{{ producto }}</li>
            {% endfor %}
        </ul>
        <a class="boton" href="{{ path('carrito_vaciar') }}">Vaciar carrito</a>
    {% else %}
        <p>El carrito está vacío.</p>
    {% endif %}

    <h2>Añadir un producto</h2>
    <div class="acciones">
        {% for producto in ['Pan', 'Leche', 'Manzana'] %}
            <a href="{{ path('carrito_anadir', {producto: producto}) }}">{{ producto }}</a>
        {% endfor %}
    </div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block body %}
<h1>Tareas</h1>
<ul>{% for tarea in tareas %}<li><a href="{{ path('app_tareas_show', {id: tarea.id}) }}">{{ tarea.titulo }}</a></li>{% endfor %}</ul>
<a href="{{ path('app_tareas', {_format: 'json'}) }}">Ver JSON</a>
<h2>Nueva tarea</h2><form action="{{ path('app_tareas_nueva') }}" method="post">
<label>Título <input name="titulo" required></label><label>Descripción <textarea name="descripcion"></textarea></label><button>Guardar tarea</button></form>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Pedidos{% endblock %}

{% block body %}
    <h1>Pedidos</h1>
    {% for plato in platoRecibido %}
        <p>Plato recibido: {{ plato }}</p>
    {% endfor %}
    <table>
        <thead>
            <tr><th>Mesa</th><th>Plato</th><th>Estado</th></tr>
        </thead>
        <tbody>
            {% for pedido in pedidos %}
                <tr><td>{{ pedido.mesa }}</td><td>{{ pedido.plato }}</td><td>{{ pedido.estado }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
